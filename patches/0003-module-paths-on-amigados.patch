jq's module search on AmigaDOS: a path with a volume ("Work:lib") is
absolute, and every directory join goes through gfjq_amiga_path
(amiga/amiga_paths.c, tests/paths_test.c). Other systems: as upstream.

--- a/src/linker.c
+++ b/src/linker.c
@@ -31,11 +31,30 @@
                         const char *as, block *out_block,
                         struct lib_loading_state *lib_state);
 
+#ifdef __amigaos__
+/* AmigaDOS module paths: each "dir/rest" join goes through gfjq_amiga_path
+ * (amiga/amiga_paths.c), which knows volumes ("Work:" takes no "/") and
+ * turns "." and ".." into AmigaDOS names */
+#include <libgen.h>
+static jv amiga_join(const char *dir, jv rest) {
+  char out[1024];
+  jv r = gfjq_amiga_path(dir, jv_string_value(rest), out, sizeof out)
+    ? jv_string(out) : jv_string_fmt("%s/%s", dir, jv_string_value(rest));
+  jv_free(rest);
+  return r;
+}
+#define PATH_JOIN(dir, fmt, ...) amiga_join((dir), jv_string_fmt(fmt, __VA_ARGS__))
+#else
+#define PATH_JOIN(dir, fmt, ...) jv_string_fmt("%s/" fmt, (dir), __VA_ARGS__)
+#endif
+
 static int path_is_relative(jv p) {
   const char *s = jv_string_value(p);
 
 #ifdef WIN32
   int res = PathIsRelativeA(s);
+#elif defined(__amigaos__)
+  int res = strchr(s, ':') == NULL;   /* "Work:lib" is absolute */
 #else
   int res = *s != '/';
 #endif
